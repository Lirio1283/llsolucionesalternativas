{
  "name": "ll-soluciones-alternativas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/preview-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify:output": "node scripts/verify-output.mjs",
    "verify": "npm run check && npm test && npm run build && npm run verify:output"
  },
  "dependencies": {
    "@sanity/webhook": "^4.0.4",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/manrope": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
