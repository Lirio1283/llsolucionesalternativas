---
import Arrow from '../../components/Arrow.astro';
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/cms';
const articles=await getArticles();const firstPage=articles.slice(0,9);const totalPages=Math.ceil(articles.length/9);
---
<Base title="Bitácora de ingeniería y construcción" description="Un espacio para compartir experiencia y preguntas útiles sobre planificación, documentación y ejecución de obras en República Dominicana."><section class="page-intro"><span class="eyebrow">BITÁCORA TÉCNICA</span><h1>Buenas preguntas.<br/>Mejores decisiones.</h1><p>Ideas y experiencia para entender su proyecto antes de tomar el siguiente paso.</p></section><section class="section">{articles.length>0?<><div class="article-grid">{firstPage.map(article=><a class="article-card" href={`/blog/${article.slug}/`}><span class="eyebrow">{article.category}</span><h2>{article.title}</h2><p>{article.excerpt}</p><span class="text-link">Leer artículo <Arrow /></span></a>)}</div>{totalPages>1&&<nav class="pagination" aria-label="Páginas de artículos">{Array.from({length:totalPages},(_,i)=><a href={i===0?'/blog/':`/blog/pagina/${i+1}/`} aria-current={i===0?'page':undefined}>{i+1}</a>)}</nav>}</>:<div class="empty-state"><span class="eyebrow">ESTAMOS PREPARANDO NUESTRA BITÁCORA</span><h2 style="margin-top:20px">La experiencia merece<br/>compartirse bien.</h2><p>Próximamente encontrará artículos sobre planificación, documentación y ejecución. ¿Tiene una pregunta sobre su obra? Conversemos directamente.</p><a class="button button-dark" href="/contacto/">Hacer una consulta <Arrow /></a></div>}</section></Base>
