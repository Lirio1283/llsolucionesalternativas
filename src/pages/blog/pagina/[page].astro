---
import Arrow from '../../../components/Arrow.astro';
import Base from '../../../layouts/Base.astro';
import {getArticles} from '../../../lib/cms';
export async function getStaticPaths(){const articles=await getArticles();const count=Math.ceil(articles.length/9);return Array.from({length:Math.max(0,count-1)},(_,i)=>({params:{page:String(i+2)},props:{page:i+2,count,articles:articles.slice((i+1)*9,(i+2)*9)}}));}
const {page,count,articles}=Astro.props;
---
<Base title={`Bitácora técnica — página ${page}`} description={`Artículos de ingeniería y construcción de LL Soluciones Alternativas. Página ${page}.`}><section class="page-intro"><span class="eyebrow">BITÁCORA TÉCNICA / PÁGINA {page}</span><h1>Más ideas para<br/>su proyecto.</h1></section><section class="section"><div class="article-grid">{articles.map(article=><a class="article-card" href={`/blog/${article.slug}/`}><span class="eyebrow">{article.category}</span><h2>{article.title}</h2><p>{article.excerpt}</p><span class="text-link">Leer artículo <Arrow /></span></a>)}</div><nav class="pagination" aria-label="Páginas de artículos">{Array.from({length:count},(_,i)=><a href={i===0?'/blog/':`/blog/pagina/${i+1}/`} aria-current={i+1===page?'page':undefined}>{i+1}</a>)}</nav></section></Base>
