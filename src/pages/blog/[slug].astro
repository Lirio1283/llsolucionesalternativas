---
import Base from '../../layouts/Base.astro';
import { getArticles,cmsProject,cmsDataset } from '../../lib/cms';
import { renderPortableText,imageUrl } from '../../lib/portable-text.mjs';
import { business,services } from '../../data/services';
export async function getStaticPaths(){return(await getArticles()).map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;const hero=imageUrl(article.hero?.asset?._ref,cmsProject,cmsDataset);
const schema={'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.excerpt,datePublished:article.publishedAt,dateModified:article._updatedAt,author:{'@type':'Person',name:article.author.name},publisher:{'@type':'Organization',name:business.legal},mainEntityOfPage:`${business.site}/blog/${article.slug}/`,...(hero?{image:hero}:{})};
const related=services.filter(service=>article.relatedServices?.includes(service.slug));
---
<Base title={article.seoTitle||article.title} description={article.seoDescription||article.excerpt} schema={schema} image={hero||undefined}><section class="page-intro"><nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/blog/">Bitácora</a></nav><span class="eyebrow">{article.category}</span><h1>{article.title}</h1><p>{article.excerpt}</p></section>{hero&&<img class="article-hero" src={hero} alt={article.hero?.alt} width="1400" height="900"/>}<div class="article-layout"><aside class="article-meta"><strong>{article.author.name}</strong>{article.author.biography&&<p>{article.author.biography}</p>}<span>Publicado</span><br/><time datetime={article.publishedAt}>{new Date(article.publishedAt).toLocaleDateString('es-DO',{year:'numeric',month:'long',day:'numeric',timeZone:'America/Santo_Domingo'})}</time><br/><a class="text-link" href="/blog/">Volver a la bitácora ↗</a></aside><article class="prose"><Fragment set:html={renderPortableText(article.body,{project:cmsProject,dataset:cmsDataset})}/>{related.length>0&&<div class="aside-note"><h2 style="margin-top:0">Servicios relacionados</h2>{related.map(service=><p><a href={`/servicios/${service.slug}/`}>{service.title} ↗</a></p>)}</div>}</article></div></Base>
