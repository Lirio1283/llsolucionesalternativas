---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services';
import { getArticles } from '../lib/cms';
const articles = (await getArticles()).slice(0,3);
const steps = [
  ['Escuchamos','Conversamos sobre su terreno, sus objetivos y el alcance que necesita.'],
  ['Definimos','Organizamos la información técnica, el diseño y las decisiones pendientes.'],
  ['Coordinamos','Conectamos documentación, recursos y ejecución según el servicio acordado.'],
  ['Acompañamos','Damos seguimiento a los avances y mantenemos clara la siguiente etapa.'],
];
---
<Base title="Ingeniería y construcción en República Dominicana" description="Ingeniería civil, agrimensura, estudios de suelos, planos, presupuestos y proyectos llave en mano en República Dominicana. Conversemos sobre su obra.">
  <section class="hero"><div class="hero-copy"><span class="eyebrow">DEL PRIMER TRAZO A LA ÚLTIMA ENTREGA</span><h1>Ideas claras.<br/>Obras <em>bien</em><br/>hechas.</h1><p>Ingeniería, diseño y construcción que conectan lo que imagina con lo que necesita ejecutar.</p><div class="hero-actions"><a class="button button-dark" href="/contacto/">Hablemos de su proyecto <span aria-hidden="true">↗</span></a><a class="text-link" href="/servicios/">Explore los servicios <span aria-hidden="true">↗</span></a></div><div class="hero-note"><span aria-hidden="true">↳</span><span><b>Una visión integral. Un alcance claro.</b><br/>Desde República Dominicana, abiertos a nuevas posibilidades.</span></div></div>
  <figure class="hero-art"><img src="/images/structure.svg" alt="Ilustración conceptual de una estructura de hormigón con terrazas y líneas de referencia arquitectónica" width="1000" height="1100" fetchpriority="high"/><span class="art-tag">FORMA + FUNCIÓN</span><div class="hero-stamp" aria-hidden="true">PENSAR<span>↗</span>CONSTRUIR</div><figcaption><span>ESTUDIO DE VOLUMEN / 01</span><span>ILUSTRACIÓN CONCEPTUAL</span></figcaption></figure></section>
  <div class="ticker"><span>UNA MISMA MESA TÉCNICA</span><b>Documentación</b><i aria-hidden="true">+</i><b>Campo</b><i aria-hidden="true">+</i><b>Diseño</b><i aria-hidden="true">+</i><b>Obra</b></div>
  <section class="section"><div class="section-head"><div><span class="eyebrow"><span class="section-number">01 /</span> PORTAFOLIO TÉCNICO</span><h2>Su proyecto cambia de etapa.<br/>Nosotros conectamos las piezas.</h2></div><p>El apoyo técnico que necesita para definir, documentar y llevar adelante su proyecto.</p></div><div class="services-grid">{services.map(service=><ServiceCard service={service}/>)}</div></section>
  <section class="section manifesto"><div><span class="eyebrow">02 / NUESTRA FORMA DE VER LA OBRA</span><h2>Antes de construir,<br/>hay que <em>entender.</em></h2><p>Un terreno. Un presupuesto. Una idea. Cada proyecto empieza con preguntas distintas. Nuestro trabajo es organizar las decisiones y conectar el criterio técnico con la ejecución.</p><p>Documentación, campo y obra bajo una misma mesa técnica, con un alcance definido para cada cliente.</p><a class="text-link" href="/nosotros/">Conozca la empresa <span aria-hidden="true">↗</span></a></div><div class="technical-drawing"><svg viewBox="0 0 500 360" fill="none" aria-hidden="true"><g stroke="#b9c2a9" stroke-width="1.3"><path d="m90 160 170-95 155 85-169 98zM90 160v116l156 86 169-96V150M246 248v114M260 65v115m-170-20 156 88 169-98"/><path d="m117 175 143-83 128 70-142 80zM118 234l128 72 140-79M118 205l128 72 140-79M118 263l128 72 140-79"/><path d="M156 145v159m52-189v215m92-241v240m51-211v183"/><path d="M45 158v122m-7-122h14m-14 122h14M91 306l157 88m-163-83 12-11m145 100 11-12M280 45l159 87m-165-81 11-11m148 98 12-12" stroke-dasharray="3 5"/></g><g fill="#ed6636"><circle cx="260" cy="65" r="4"/><circle cx="90" cy="160" r="4"/><circle cx="415" cy="150" r="4"/><circle cx="246" cy="248" r="4"/></g></svg><span class="drawing-caption">LL—02 / CRITERIO, COORDINACIÓN, EJECUCIÓN</span></div></section>
  <section class="section"><div class="section-head"><div><span class="eyebrow"><span class="section-number">03 /</span> DE LA IDEA AL ALCANCE</span><h2>Un proceso que<br/>pone orden a la obra.</h2></div><p>Sin fórmulas universales. Cada servicio se define a partir de lo que su proyecto realmente necesita.</p></div><div class="process-grid">{steps.map(([title,text],i)=><div class="process-item"><span class="number">0{i+1} ↗</span><h3>{title}</h3><p>{text}</p></div>)}</div></section>
  <section class="field-note"><div><span class="eyebrow">DE AQUÍ, CON VISIÓN ABIERTA</span><h2>República Dominicana.<br/>Nuevas posibilidades.</h2></div><p>Estamos establecidos en la República Dominicana. Si su proyecto está en otro país, conversemos para evaluar el alcance y las posibilidades de colaboración.</p><a class="text-link" href="/contacto/">Cuéntenos dónde <span aria-hidden="true">↗</span></a></section>
  <section class="section"><div class="section-head"><div><span class="eyebrow"><span class="section-number">04 /</span> BITÁCORA TÉCNICA</span><h2>El conocimiento también<br/>es una herramienta.</h2></div><a class="text-link" href="/blog/">Explore la bitácora <span aria-hidden="true">↗</span></a></div>{articles.length > 0 ? <div class="article-grid">{articles.map(article=><a class="article-card" href={`/blog/${article.slug}/`}><span class="eyebrow">{article.category}</span><h3>{article.title}</h3><p>{article.excerpt}</p><span class="text-link">Leer artículo ↗</span></a>)}</div> : <div class="empty-state"><span class="eyebrow">UN ESPACIO PARA COMPARTIR EXPERIENCIA</span><h3 style="font-size:26px; margin-top:18px">Cada buena obra empieza con buenas preguntas.</h3><p>Estamos preparando nuestra bitácora sobre planificación, documentación y ejecución. Mientras tanto, conversemos sobre las preguntas de su proyecto.</p><a class="text-link" href="/contacto/">Haga su primera consulta <span aria-hidden="true">↗</span></a></div>}</section>
</Base>
